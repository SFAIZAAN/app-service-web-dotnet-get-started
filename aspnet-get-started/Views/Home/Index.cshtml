@model List<aspnet_get_started.Models.RentalRecord>
@{
    ViewBag.Title = "Rent Dashboard";
}

<div class="jumbotron">
    <h1>SF Rental</h1>
    <p class="lead">Track rents, advance payments, and outstanding dues for each tenant.</p>
    <p>
        @Html.ActionLink("Add New Rent Record", "Add", "Home", null, new { @class = "btn btn-primary btn-lg" })
    </p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="panel panel-info">
            <div class="panel-heading"><strong>Total Due</strong></div>
            <div class="panel-body">₹@ViewBag.TotalDue</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-warning">
            <div class="panel-heading"><strong>Total Advance</strong></div>
            <div class="panel-body">₹@ViewBag.TotalAdvance</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel panel-success">
            <div class="panel-heading"><strong>Total Collected</strong></div>
            <div class="panel-body">₹@ViewBag.TotalCollected</div>
        </div>
    </div>
</div>

<h2>Tenant Rent Ledger</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Tenant</th>
            <th>Property</th>
            <th>Rent Month</th>
            <th>Monthly Rent</th>
            <th>Advance</th>
            <th>Paid</th>
            <th>Due</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TenantName</td>
                <td>@item.PropertyName</td>
                <td>@item.DueMonth</td>
                <td>₹@item.MonthlyRent</td>
                <td>₹@item.AdvancePaid</td>
                <td>₹@item.AmountPaid</td>
                <td>₹@item.DueAmount</td>
                <td>
                    @if (item.DueAmount == 0)
                    {
                        <span class="label label-success">Paid</span>
                    }
                    else if (item.AmountPaid > 0)
                    {
                        <span class="label label-warning">Partial</span>
                    }
                    else
                    {
                        <span class="label label-danger">Pending</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
